<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Meta de memória ociosa da spec 001 (< 80 MB): app de um usuário não precisa do Server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AssemblyName>MyRemoteControll.Agent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os usings implícitos do WinForms colidem com tipos do ASP.NET Core; a bandeja importa explicitamente. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyRemoteControll.Agent.Tests" />
    <InternalsVisibleTo Include="MyRemoteControll.Agent.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyRemoteControll.Contracts\MyRemoteControll.Contracts.csproj" />
    <ProjectReference Include="..\MyRemoteControll.Windows\MyRemoteControll.Windows.csproj" />
    <ProjectReference Include="..\MyRemoteControll.Claude\MyRemoteControll.Claude.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
