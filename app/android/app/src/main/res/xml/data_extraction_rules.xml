<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada do app vai para backup na nuvem nem para transferência entre aparelhos (Android 12+): os PCs pareados e os
  tokens são deste aparelho. Num aparelho novo, pareia-se de novo (spec 004). O allowBackup="false" do manifesto cobre
  o Android 11 e anteriores.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
